{
  "name": "@art-md/bin",
  "version": "0.0.1",
  "description": "CLI that exposes parser and serializer as commands.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-md",
    "directory": "cli/bin"
  },
  "bin": {
    "art-codec": "./dist/codec.mjs",
    "art-parse": "./dist/parse.mjs",
    "art-serialize": "./dist/serialize.mjs"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir test",
    "ci": "npm run lint && npm run build && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@art-md/codec": "*",
    "@art-md/primitives": "*",
    "commander": "^12.0.0"
  },
  "devDependencies": {}
}
