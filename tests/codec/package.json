{
  "name": "@art-md/codec-tests",
  "version": "0.0.1",
  "description": "Test scripts for the parser and serializer through the codec.",
  "keywords": [
    "art",
    "markdown",
    "testing"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-md.git",
    "directory": "tests/codec"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "scripts",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test-parser": "tsx scripts/test-parser.ts",
    "test-serializer": "tsx scripts/test-serializer.ts",
    "test": "npm run test-parser && npm run test-serializer",
    "ci": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@art-md/codec": "*"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
