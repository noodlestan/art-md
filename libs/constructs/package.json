{
  "name": "@art-md/constructs",
  "version": "0.0.6",
  "description": "Construct factories for Art parser records.",
  "keywords": [
    "library",
    "constructs",
    "art",
    "markdown",
    "ast",
    "structured-data",
    "agent-instructions"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-md.git",
    "directory": "libs/constructs/"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./test-helpers/*": {
      "import": "./src/test/helpers/*"
    }
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@art-md/primitives": "*",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-phrasing": "4.1.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "vitest": "5.0.5"
  }
}
